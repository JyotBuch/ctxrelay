(foo)) is foo\n\n\nclass ErrorsHelper:\n    @property\n    def raise_baseexception(self):\n        raise BaseException(\"base exception should be raised\")\n\n    @property\n    def raise_exception(self):\n        raise Exception(\"exception should be caught\")\n\n    @property\n    def raise_fail_outcome(self):\n        pytest.fail(\"fail should be caught\")\n\n\ndef test_helper_failures() -> None:\n/Users/jyotbuch/MultiSubscriptionAgent/eval/bench/tasks/boundary_flake/base/AGENTS.md\n/Users/jyotbuch/MultiSubscriptionAgent/eval/bench/tasks/tz_parse/base/AGENTS.md\n/Users/jyotbuch/MultiSubscriptionAgent/eval/bench/tasks/retry_policy/base/AGENTS.md\n/Users/jyotbuch/MultiSubscriptionAgent/eval/bench/tasks/rename_field/base/AGENTS.md\n/Users/jyotbuch/MultiSubscriptionAgent/eval/bench/tasks/stale_cache/base/AGENTS.md\n/Users/jyotbuch/MultiSubscriptionAgent/eval/bench/tasks/csv_export/base/AGENTS.md\n/tmp/claude-501/-Users-jyotbuch-MultiSubscriptionAgent/6f5d2174-01cd-4051-9de3-4541aa0fd6c4/scratchpad/cleanproj/AGENTS.md\n/tmp/claude-501/-Users-jyotbuch-MultiSubscriptionAgent/6f5d2174-01cd-4051-9de3-4541aa0fd6c4/scratchpad/pp/AGENTS.md\n/tmp/claude-501/-Users-jyotbuch-MultiSubscriptionAgent/6f5d2174-01cd-4051-9de3-4541aa0fd6c4/scratchpad/smoke/AGENTS.md\n/tmp/claude-501/-Users-jyotbuch-MultiSubscriptionAgent/6f5d2174-01cd-4051-9de3-4541aa0fd6c4/scratchpad/e2e/move_abspath_A/AGENTS.md\n/tmp/claude-501/-Users-jyotbuch-MultiSubscriptionAgent/6f5d2174-01cd-4051-9de3-4541aa0fd6c4/scratchpad/e2e/fnmatch_A/AGENTS.md\n/tmp/claude-501/-Users-jyotbuch-MultiSubscriptionAgent/6f5d2174-01cd-4051-9de3-4541aa0fd6c4/scratchpad/e2e/move_fnmatch_A/AGENTS.md\n/tmp/claude-501/-Users-jyotbuch-MultiSubscriptionAgent/6f5d2174-01cd-4051-9de3-4541aa0fd6c4/scratchpad/e2e/move_abspath_C3/AGENTS.md\n/tmp/claude-501/-Users-jyotbuch-MultiSubscriptionAgent/6f5d2174-01cd-4051-9de3-4541aa0fd6c4/scratchpad/e2e/fnmatch_C3/AGENTS.md\n/tmp/claude-501/-Users-jyotbuch-MultiSubscriptionAgent/6f5d2174-01cd-4051